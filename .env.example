ALPACA_ENDPOINT=https://api.alpaca.markets
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets

MYDASHBOARD_USER=mike.rep@me.com
MYDASHBOARD_PASSWORD=
MYDASHBOARD_SESSION_SECRET=

DATABASE_URL=postgresql://mikepage:mikepage@localhost:5432/mikepage
DIRECT_URL=postgresql://mikepage:mikepage@localhost:5432/mikepage
INTERNAL_JOB_TOKEN=

# Railway production:
# - Web service: set DATABASE_URL from Postgres and all dashboard variables here.
# - Weekly reviews call POST /api/jobs/evaluate-weekly with X-Internal-Token.
# - PYTHON_API_URL is no longer needed for the dashboard.
PYTHON_API_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
AI_WATCHLIST=NVDA,TSM,PLTR,ASML,ABB,VRT,ETN,FCX,CCJ,TSLA
AI_MOCK_RESPONSES=false

TRADING_ENABLED=false
ALPACA_ALLOW_LIVE_TRADING=false
SCHEDULER_ENABLED=false
SCHEDULE_TIMEZONE=America/New_York
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=45
MAX_WEEKLY_BP_PCT=0.50
MAX_ASSET_BP_PCT=0.15
RESERVE_BP_PCT=0.05

# Deprecated: storage now uses DATABASE_URL/Postgres.
API_DB_PATH=/data/trading.sqlite3
