generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WealthSnapshot {
  id           Int      @id @default(autoincrement())
  weekKey      String   @unique @map("week_key")
  year         Int
  week         Int
  currency     String   @default("CHF")
  total        Decimal  @db.Decimal(12, 2)
  savings      Decimal  @db.Decimal(12, 2)
  cashReserve  Decimal  @map("cash_reserve") @db.Decimal(12, 2)
  investments  Decimal  @db.Decimal(12, 2)
  mintos       Decimal  @db.Decimal(12, 2)
  bondora      Decimal  @db.Decimal(12, 2)
  alpaca       Decimal  @db.Decimal(12, 2)
  bankAccount  Decimal  @map("bank_account") @db.Decimal(12, 2)
  card         Decimal  @db.Decimal(12, 2)
  legacyDegiro Decimal  @default(0) @map("legacy_degiro") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([year, week])
  @@map("wealth_snapshots")
}

model InvestmentAsset {
  id            Int       @id @default(autoincrement())
  name          String
  value         Decimal   @db.Decimal(12, 2)
  totalValue    Decimal?  @map("total_value") @db.Decimal(12, 2)
  sharePercent  Decimal?  @map("share_percent") @db.Decimal(7, 4)
  valuationDate DateTime? @map("valuation_date") @db.Date
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("investment_assets")
}

model HealthEntry {
  id             Int      @id @default(autoincrement())
  date           DateTime @unique @db.Date
  bloodPressure1 Int?     @map("blood_pressure_1")
  bloodPressure2 Int?     @map("blood_pressure_2")
  waistCm        Decimal? @map("waist_cm") @db.Decimal(5, 1)
  bodyFatPercent Decimal? @map("body_fat_percent") @db.Decimal(4, 1)
  weightKg       Decimal? @map("weight_kg") @db.Decimal(5, 1)
  pulse          Int?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("health_entries")
}

model HealthGoal {
  id             Int      @id @default(1)
  bloodPressure1 Int?     @map("blood_pressure_1")
  bloodPressure2 Int?     @map("blood_pressure_2")
  waistCm        Decimal? @map("waist_cm") @db.Decimal(5, 1)
  bodyFatPercent Decimal? @map("body_fat_percent") @db.Decimal(4, 1)
  weightKg       Decimal? @map("weight_kg") @db.Decimal(5, 1)
  pulse          Int?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("health_goals")
}

model GoogleHealthConnection {
  id                     Int       @id @default(1)
  refreshTokenCiphertext String    @map("refresh_token_ciphertext")
  refreshTokenExpiresAt  DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  grantedScopes          String    @default("") @map("granted_scopes")
  lastSyncedAt           DateTime? @map("last_synced_at") @db.Timestamptz(3)
  backfillBefore         DateTime? @map("backfill_before") @db.Timestamptz(3)
  connectedAt            DateTime  @default(now()) @map("connected_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("google_health_connections")
}

model HeartRateSample {
  id             Int      @id @default(autoincrement())
  measuredAt     DateTime @unique @map("measured_at") @db.Timestamptz(3)
  beatsPerMinute Int      @map("beats_per_minute")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("heart_rate_samples")
}

model DailyStepCount {
  date      DateTime @id @db.Date
  steps     Int
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("daily_step_counts")
}

model GoogleHealthSleepInterval {
  id        Int      @id @default(autoincrement())
  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime @map("ended_at") @db.Timestamptz(3)

  @@unique([startedAt, endedAt])
  @@index([endedAt])
  @@map("google_health_sleep_intervals")
}

model WithingsConnection {
  id                     Int       @id @default(1)
  userId                 BigInt    @unique @map("user_id")
  accessTokenCiphertext  String    @map("access_token_ciphertext")
  accessTokenExpiresAt   DateTime  @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenCiphertext String    @map("refresh_token_ciphertext")
  refreshTokenExpiresAt  DateTime  @map("refresh_token_expires_at") @db.Timestamptz(3)
  grantedScopes          String    @default("") @map("granted_scopes")
  lastUpdate             BigInt?   @map("last_update")
  lastSyncedAt           DateTime? @map("last_synced_at") @db.Timestamptz(3)
  connectedAt            DateTime  @default(now()) @map("connected_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("withings_connections")
}

model WithingsMeasurement {
  groupId        BigInt    @id @map("group_id")
  measuredAt     DateTime  @map("measured_at") @db.Timestamptz(3)
  weightKg       Decimal?  @map("weight_kg") @db.Decimal(6, 3)
  bodyFatPercent Decimal?  @map("body_fat_percent") @db.Decimal(5, 2)
  isDeleted      Boolean   @default(false) @map("is_deleted")
  modifiedAt     DateTime? @map("modified_at") @db.Timestamptz(3)
  deviceId       String?   @map("device_id")
  model          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isDeleted, measuredAt, groupId])
  @@map("withings_measurements")
}

model PullUpEntry {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pull_up_entries")
}

model AssetPriceBar {
  id        Int      @id @default(autoincrement())
  symbol    String
  date      DateTime @db.Date
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    Decimal  @db.Decimal(20, 2)
  source    String   @default("alpaca")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([symbol, date])
  @@index([symbol, date])
  @@map("asset_price_bars")
}

model Run {
  id         Int       @id @default(autoincrement())
  runDate    DateTime  @map("run_date") @db.Date
  kind       String
  status     String
  createdAt  DateTime  @default(now()) @map("created_at")
  finishedAt DateTime? @map("finished_at")
  reviews    Review[]
  strategies StrategyVersion[]

  @@unique([runDate, kind])
  @@map("runs")
}

model StrategyVersion {
  id           Int      @id @default(autoincrement())
  version      Int      @unique
  runId        Int?     @map("run_id")
  run          Run?     @relation(fields: [runId], references: [id])
  strategyJson Json     @map("strategy_json")
  rationale    String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([runId])
  @@index([createdAt])
  @@map("strategy_versions")
}

model Review {
  id           Int      @id @default(autoincrement())
  runId        Int?     @map("run_id")
  run          Run?     @relation(fields: [runId], references: [id])
  symbol       String
  analysisJson Json     @map("analysis_json")
  decisionJson Json     @map("decision_json")
  orderJson    Json     @map("order_json")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([runId])
  @@index([createdAt])
  @@map("reviews")
}
